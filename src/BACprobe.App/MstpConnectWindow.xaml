<Window x:Class="BACprobe.App.MstpConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:BACprobe.App"
        Title="Connect to an MS/TP trunk" Icon="Assets/app.ico" Width="820" Height="640" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <DockPanel Margin="20">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button DockPanel.Dock="Right" Content="Close" Padding="20,5" Margin="8,0,0,0" IsCancel="True" Click="OnClose" />
      <Button DockPanel.Dock="Right" Content="Join the trunk..." Padding="20,5" Style="{DynamicResource AccentButtonStyle}"
              IsEnabled="{Binding CanJoin}" Click="OnJoin" AutomationProperties.Name="Join the trunk"
              ToolTip="Becomes a master on the trunk so BACprobe can find devices, read points and write. This transmits, and asks you to confirm first." />
      <TextBlock Text="Joining transmits on the trunk (token passing and your requests). Listening never does."
                 TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.8" />
    </DockPanel>

    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
               Text="BACprobe first LISTENS to the trunk for 15 seconds without sending anything. Only if it looks healthy does it offer to join as a master, so it can find devices and read their points like it does on BACnet/IP." />

    <WrapPanel DockPanel.Dock="Top" Margin="0,14,0,0">
      <TextBlock Text="Port" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" Width="110" Margin="8,0,0,0"
                IsEnabled="{Binding IsIdle}" AutomationProperties.Name="COM port"
                ToolTip="The USB-RS485 adapter's COM port. Device Manager shows which one it is." />
      <Button Content="Refresh" Padding="10,4" Margin="6,0,0,0" Command="{Binding RefreshPortsCommand}" IsEnabled="{Binding IsIdle}" />
      <TextBlock Text="Baud" VerticalAlignment="Center" Margin="16,0,0,0" />
      <ComboBox ItemsSource="{x:Static app:MstpConnectViewModel.Bauds}" SelectedItem="{Binding SelectedBaud}" Width="130" Margin="8,0,0,0"
                IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Baud rate"
                ToolTip="Auto-detect listens a few seconds at each common rate. Field trunks are mostly 38400 or 76800." />
      <TextBlock Text="My MAC" VerticalAlignment="Center" Margin="16,0,0,0" />
      <TextBox Text="{Binding MacText, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="8,0,0,0" IsEnabled="{Binding IsIdle}"
               AutomationProperties.Name="BACprobe's MAC"
               ToolTip="The master address BACprobe takes on the trunk (0 to 127). Auto picks the lowest free one the other masters will poll. Never use an address another device has." />
      <Button Content="Listen first (15 s)" Padding="16,4" Margin="16,0,0,0" Command="{Binding ListenCommand}"
              AutomationProperties.Name="Listen first" />
      <Button Content="Cancel" Padding="12,4" Margin="6,0,0,0" Command="{Binding CancelListenCommand}" />
    </WrapPanel>

    <Border DockPanel.Dock="Top" Margin="0,10,0,0" Padding="10,6" CornerRadius="4" Background="{DynamicResource WarningBackgroundBrush}"
            Visibility="{Binding HasLatencyWarning, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="{Binding LatencyWarning}" TextWrapping="Wrap" />
    </Border>

    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,12,0,0"
                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
    <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.9" />
    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0" />

    <Border BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}" CornerRadius="4" Padding="8,4" Margin="0,10,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Findings}" />
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
